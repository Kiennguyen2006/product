@model Nguyenkhackien_exam.Models.Nkkemployee

@{
    ViewData["Title"] = "Xóa nhân viên";
}

<style>
    .delete-page {
        min-height: calc(100vh - 180px);
        padding: 40px 15px;
        background: linear-gradient(135deg, #fff5f5, #ffffff);
    }

    .delete-card {
        max-width: 700px;
        margin: 0 auto;
        background: #ffffff;
        border-radius: 20px;
        padding: 35px 40px;
        box-shadow: 0 10px 35px rgba(0, 0, 0, 0.08);
        border: 1px solid #eeeeee;
    }

    .delete-title {
        text-align: center;
        color: #dc3545;
        font-size: 32px;
        font-weight: 700;
        margin-bottom: 8px;
    }

    .delete-subtitle {
        text-align: center;
        color: #777777;
        margin-bottom: 25px;
    }

    .delete-line {
        width: 70px;
        height: 4px;
        background: #dc3545;
        border-radius: 10px;
        margin: 0 auto 30px auto;
    }

    .warning-box {
        background: #fff3cd;
        border: 1px solid #ffe69c;
        color: #664d03;
        border-radius: 10px;
        padding: 15px;
        margin-bottom: 25px;
        text-align: center;
        font-size: 15px;
    }

    .employee-info {
        border: 1px solid #eeeeee;
        border-radius: 12px;
        overflow: hidden;
        margin-bottom: 25px;
    }

    .info-row {
        display: flex;
        padding: 14px 18px;
        border-bottom: 1px solid #eeeeee;
    }

    .info-row:last-child {
        border-bottom: none;
    }

    .info-title {
        width: 35%;
        font-weight: 600;
        color: #555555;
    }

    .info-value {
        width: 65%;
        color: #222222;
    }

    .button-area {
        display: flex;
        gap: 12px;
        margin-top: 25px;
    }

    .btn-delete {
        flex: 1;
        height: 48px;
        border: none;
        border-radius: 10px;
        background: #dc3545;
        color: white;
        font-size: 15px;
        font-weight: 600;
        cursor: pointer;
        transition: 0.2s;
    }

    .btn-delete:hover {
        background: #bb2d3b;
        transform: translateY(-2px);
        box-shadow: 0 6px 18px rgba(220, 53, 69, 0.25);
    }

    .btn-back {
        flex: 1;
        height: 48px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 10px;
        background: #eeeeee;
        color: #333333;
        text-decoration: none;
        font-size: 15px;
        font-weight: 600;
        transition: 0.2s;
    }

    .btn-back:hover {
        background: #dddddd;
        color: #222222;
    }

    @@media (max-width: 600px) {
        .delete-card {
            padding: 25px 20px;
        }

        .delete-title {
            font-size: 27px;
        }

        .info-row {
            display: block;
        }

        .info-title,
        .info-value {
            width: 100%;
        }

        .info-value {
            margin-top: 5px;
        }

        .button-area {
            flex-direction: column;
        }

        .btn-delete,
        .btn-back {
            flex: none;
        }
    }
</style>

<div class="delete-page">

    <div class="delete-card">

        <h1 class="delete-title">Xóa nhân viên</h1>

        <div class="delete-subtitle">
            Xác nhận thông tin trước khi xóa
        </div>

        <div class="delete-line"></div>

        <div class="warning-box">
            Bạn có chắc chắn muốn xóa nhân viên này không?
            <br />
            Dữ liệu sau khi xóa sẽ không thể khôi phục.
        </div>

        <div class="employee-info">

            <div class="info-row">
                <div class="info-title">
                    Họ tên
                </div>

                <div class="info-value">
                    @Html.DisplayFor(model => model.Nkkname)
                </div>
            </div>

            <div class="info-row">
                <div class="info-title">
                    Giới tính
                </div>

                <div class="info-value">
                    @Html.DisplayFor(model => model.Nkkgender)
                </div>
            </div>

            <div class="info-row">
                <div class="info-title">
                    Ngày sinh
                </div>

                <div class="info-value">
                    @Html.DisplayFor(model => model.NkkbirthDay)
                </div>
            </div>

            <div class="info-row">
                <div class="info-title">
                    Email
                </div>

                <div class="info-value">
                    @Html.DisplayFor(model => model.Nkkemail)
                </div>
            </div>

            <div class="info-row">
                <div class="info-title">
                    Số điện thoại
                </div>

                <div class="info-value">
                    @Html.DisplayFor(model => model.Nkkphone)
                </div>
            </div>

            <div class="info-row">
                <div class="info-title">
                    Hoạt động
                </div>

                <div class="info-value">
                    @Html.DisplayFor(model => model.Nkkactive)
                </div>
            </div>

        </div>

        <form asp-action="Delete">

            <input type="hidden" asp-for="Id" />

            <div class="button-area">

                <input type="submit"
                       value="Xóa nhân viên"
                       class="btn-delete" />

                <a asp-action="Index"
                   class="btn-back">
                    Quay lại
                </a>

            </div>

        </form>

    </div>

</div>