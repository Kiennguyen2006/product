@model IEnumerable<Nguyenkhackien_exam.Models.Nkkemployee>

@{
    ViewData["Title"] = "Quản lý nhân viên";
}

<style>
    .employee-page {
        min-height: calc(100vh - 180px);
        padding: 40px 20px;
        background: linear-gradient(135deg, #f5f7ff, #ffffff);
    }

    .employee-container {
        max-width: 1400px;
        margin: 0 auto;
    }

    .employee-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 25px;
        gap: 20px;
    }

    .employee-title {
        margin: 0;
        color: #2b1766;
        font-size: 32px;
        font-weight: 700;
    }

    .employee-subtitle {
        margin-top: 6px;
        color: #777777;
        font-size: 15px;
    }

    .btn-create {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        padding: 12px 22px;
        border-radius: 10px;
        background: linear-gradient(135deg, #32166d, #5429b8);
        color: white;
        text-decoration: none;
        font-size: 15px;
        font-weight: 600;
        transition: 0.2s;
        white-space: nowrap;
    }

    .btn-create:hover {
        color: white;
        transform: translateY(-2px);
        box-shadow: 0 6px 18px rgba(50, 22, 109, 0.25);
    }

    .table-card {
        background: #ffffff;
        border-radius: 18px;
        padding: 20px;
        box-shadow: 0 10px 35px rgba(0, 0, 0, 0.07);
        border: 1px solid #eeeeee;
        overflow-x: auto;
    }

    .employee-table {
        width: 100%;
        border-collapse: collapse;
        min-width: 1000px;
    }

    .employee-table thead th {
        padding: 16px 14px;
        background: linear-gradient(135deg, #32166d, #5429b8);
        color: white;
        font-size: 14px;
        font-weight: 600;
        text-align: left;
        border: none;
        white-space: nowrap;
    }

    .employee-table thead th:first-child {
        border-radius: 10px 0 0 10px;
    }

    .employee-table thead th:last-child {
        border-radius: 0 10px 10px 0;
    }

    .employee-table tbody td {
        padding: 15px 14px;
        border-bottom: 1px solid #eeeeee;
        color: #444444;
        font-size: 14px;
        vertical-align: middle;
    }

    .employee-table tbody tr {
        transition: 0.2s;
    }

    .employee-table tbody tr:hover {
        background-color: #f8f6ff;
    }

    .employee-table tbody tr:last-child td {
        border-bottom: none;
    }

    .employee-name {
        font-weight: 600;
        color: #2b1766 !important;
    }

    .employee-email {
        color: #555555;
    }

    .employee-phone {
        white-space: nowrap;
    }

    .status-active {
        display: inline-block;
        padding: 6px 12px;
        border-radius: 20px;
        background-color: #e8f8ee;
        color: #218838;
        font-size: 13px;
        font-weight: 600;
    }

    .status-inactive {
        display: inline-block;
        padding: 6px 12px;
        border-radius: 20px;
        background-color: #fce8e8;
        color: #c82333;
        font-size: 13px;
        font-weight: 600;
    }

    .action-area {
        display: flex;
        align-items: center;
        gap: 8px;
        white-space: nowrap;
    }

    .action-edit,
    .action-details,
    .action-delete {
        display: inline-block;
        padding: 7px 11px;
        border-radius: 7px;
        text-decoration: none;
        font-size: 13px;
        font-weight: 600;
        transition: 0.2s;
    }

    .action-edit {
        background-color: #eee9ff;
        color: #5429b8;
    }

    .action-edit:hover {
        background-color: #5429b8;
        color: white;
    }

    .action-details {
        background-color: #e8f1ff;
        color: #1769aa;
    }

    .action-details:hover {
        background-color: #1769aa;
        color: white;
    }

    .action-delete {
        background-color: #ffe9e9;
        color: #d32f2f;
    }

    .action-delete:hover {
        background-color: #d32f2f;
        color: white;
    }

    @@media (max-width: 700px) {

        .employee-page {
            padding: 25px 12px;
        }

        .employee-header {
            flex-direction: column;
            align-items: flex-start;
        }

        .employee-title {
            font-size: 27px;
        }

        .btn-create {
            width: 100%;
        }

        .table-card {
            padding: 12px;
        }
    }
</style>

<div class="employee-page">

    <div class="employee-container">

        <div class="employee-header">

            <div>
                <h1 class="employee-title">
                    Quản lý nhân viên
                </h1>

                <div class="employee-subtitle">
                    Danh sách thông tin nhân viên trong hệ thống
                </div>
            </div>

            <a asp-action="Create" class="btn-create">
                + Thêm nhân viên
            </a>

        </div>

        <div class="table-card">

            <table class="employee-table">

                <thead>
                    <tr>
                        <th>
                            Họ tên
                        </th>

                        <th>
                            Giới tính
                        </th>

                        <th>
                            Ngày sinh
                        </th>

                        <th>
                            Email
                        </th>

                        <th>
                            Số điện thoại
                        </th>

                        <th>
                            Trạng thái
                        </th>

                        <th>
                            Thao tác
                        </th>
                    </tr>
                </thead>

                <tbody>

                    @foreach (var item in Model)
                    {
                        <tr>

                            <td class="employee-name">
                                @Html.DisplayFor(model => item.Nkkname)
                            </td>

                            <td>
                                @Html.DisplayFor(model => item.Nkkgender)
                            </td>

                            <td>
                                @Html.DisplayFor(model => item.NkkbirthDay)
                            </td>

                            <td class="employee-email">
                                @Html.DisplayFor(model => item.Nkkemail)
                            </td>

                            <td class="employee-phone">
                                @Html.DisplayFor(model => item.Nkkphone)
                            </td>

                            <td>
                                @if (item.Nkkactive == true)
                                {
                                    <span class="status-active">
                                        Đang hoạt động
                                    </span>
                                }
                                else
                                {
                                    <span class="status-inactive">
                                        Ngừng hoạt động
                                    </span>
                                }
                            </td>

                            <td>

                                <div class="action-area">

                                    <a asp-action="Edit"
                                       asp-route-id="@item.Id"
                                       class="action-edit">
                                        Sửa
                                    </a>

                                    <a asp-action="Details"
                                       asp-route-id="@item.Id"
                                       class="action-details">
                                        Chi tiết
                                    </a>

                                    <a asp-action="Delete"
                                       asp-route-id="@item.Id"
                                       class="action-delete">
                                        Xóa
                                    </a>

                                </div>

                            </td>

                        </tr>
                    }

                </tbody>

            </table>

        </div>

    </div>

</div>