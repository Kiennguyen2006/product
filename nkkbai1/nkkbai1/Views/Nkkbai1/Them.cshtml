@model nkkbai1.Models.Nkkbai1Model

@{
    ViewData["Title"] = "Thêm sản phẩm";
}
<form asp-controller="Nkkbai1" asp-action="Themsp" method="POST" enctype="multipart/form-data">
<div class="container my-4">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-primary text-white py-3">
                    <h4 class="card-title mb-0 fw-bold">Thêm mới sản phẩm</h4>
                </div>
                <div class="card-body p-4">
                    <form asp-action="Them" method="post">
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                        <div class="mb-3">
                            <label asp-for="tensp" class="form-label fw-semibold">Tên sản phẩm</label>
                            <input asp-for="tensp" class="form-control" placeholder="Nhập tên sản phẩm" />
                            <span asp-validation-for="tensp" class="text-danger small"></span>
                        </div>

                        <div class="row mb-3">
                            <div class="col-md-6 mb-3 mb-md-0">
                                <label asp-for="gia" class="form-label fw-semibold">Giá bán</label>
                                <input asp-for="gia" type="number" class="form-control" placeholder="0" />
                                <span asp-validation-for="gia" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="soluong" class="form-label fw-semibold">Số lượng</label>
                                <input asp-for="soluong" type="number" class="form-control" placeholder="0" />
                                <span asp-validation-for="soluong" class="text-danger small"></span>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label asp-for="loai" class="form-label fw-semibold">Loại sản phẩm</label>
                            <input asp-for="loai" class="form-control" placeholder="Nhập mã loại" />
                            <span asp-validation-for="loai" class="text-danger small"></span>
                        </div>

                        <div class="mb-4">
                            <label asp-for="anh" class="form-label fw-semibold">Hình ảnh</label>
                                <input type="file" name="anhFile" class="form-control" placeholder="Tên file hoặc URL ảnh" />
                            <span asp-validation-for="anh" class="text-danger small"></span>
                        </div>

                        <div class="d-flex justify-content-between align-items-center pt-2">
                            <a asp-action="Nkkbai1" class="btn btn-outline-secondary">Quay lại danh sách</a>
                            <button type="submit" class="btn btn-primary px-4">Thêm mới</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
</form>
@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}