@model Nkklession14layout.Models.NkkShopListViewModel
@{
    ViewData["Title"] = Model.Title;
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
    <h1 class="h2 mb-0">@Model.Title</h1>
    <a class="btn btn-primary" asp-action="NkkCreate" asp-route-entity="@Model.Entity">Thêm @Model.Title.ToLowerInvariant()</a>
</div>

<div class="d-flex flex-wrap gap-2 mb-3">
    <a class="btn btn-outline-secondary btn-sm" asp-action="NkkList" asp-route-entity="dien-thoai">Điện thoại</a>
    <a class="btn btn-outline-secondary btn-sm" asp-action="NkkList" asp-route-entity="nha-cung-cap">Nhà cung cấp</a>
    <a class="btn btn-outline-secondary btn-sm" asp-action="NkkList" asp-route-entity="khach-hang">Khách hàng</a>
    <a class="btn btn-outline-secondary btn-sm" asp-action="NkkList" asp-route-entity="nhan-vien">Nhân viên</a>
    <a class="btn btn-outline-secondary btn-sm" asp-action="NkkList" asp-route-entity="hoa-don">Hóa đơn</a>
    <a class="btn btn-outline-secondary btn-sm" asp-action="NkkList" asp-route-entity="chi-tiet-hoa-don">Chi tiết hóa đơn</a>
    <a class="btn btn-outline-secondary btn-sm" asp-action="NkkList" asp-route-entity="phieu-nhap">Phiếu nhập</a>
    <a class="btn btn-outline-secondary btn-sm" asp-action="NkkList" asp-route-entity="chi-tiet-phieu-nhap">Chi tiết phiếu nhập</a>
</div>

@if (TempData["Success"] is string success)
{
    <div class="alert alert-success">@success</div>
}
@if (TempData["Error"] is string error)
{
    <div class="alert alert-danger">@error</div>
}

<div class="mb-3">
    <label for="tableSearch" class="form-label">Tìm trong danh sách</label>
    <input id="tableSearch" class="form-control" type="search" placeholder="Nhập nội dung cần tìm..." />
</div>

<div class="table-responsive">
    <table class="table table-striped table-hover align-middle">
        <thead>
            <tr>
                @foreach (var column in Model.Columns)
                {
                    <th scope="col">@column</th>
                }
                <th scope="col">Thao tác</th>
            </tr>
        </thead>
        <tbody id="recordRows">
            @foreach (var row in Model.Rows)
            {
                <tr>
                    @foreach (var value in row.Values)
                    {
                        <td>@value</td>
                    }
                    <td class="text-nowrap">
                        <a class="btn btn-sm btn-outline-primary" asp-action="NkkEdit" asp-route-entity="@Model.Entity" asp-route-key="@row.Key">Sửa</a>
                        <form asp-action="NkkDelete" method="post" class="d-inline" onsubmit="return confirm('Bạn có chắc muốn xóa bản ghi này?');">
                            <input type="hidden" name="entity" value="@Model.Entity" />
                            <input type="hidden" name="key" value="@row.Key" />
                            <button class="btn btn-sm btn-outline-danger" type="submit">Xóa</button>
                        </form>
                    </td>
                </tr>
            }
            @if (Model.Rows.Count == 0)
            {
                <tr><td colspan="@(Model.Columns.Count + 1)" class="text-center text-muted py-4">Chưa có dữ liệu.</td></tr>
            }
        </tbody>
    </table>
</div>

@section Scripts {
    <script>
        document.getElementById("tableSearch").addEventListener("input", function () {
            const query = this.value.toLocaleLowerCase();
            document.querySelectorAll("#recordRows tr").forEach(row => {
                row.hidden = !row.textContent.toLocaleLowerCase().includes(query);
            });
        });
    </script>
}

