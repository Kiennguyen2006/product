@model Nkklession14layout.Models.NkkForgotPasswordViewModel
@{
    ViewData["Title"] = "Quên mật khẩu";
}

<div class="auth-card">
    <h1 class="h3 mb-3">Quên mật khẩu</h1>
    @if (ViewBag.StatusMessage is string status)
    {
        <div class="alert alert-info">@status</div>
    }
    <p class="text-muted">Nhập email đã đăng ký để nhận mã xác nhận đặt lại mật khẩu.</p>
    <form asp-action="NkkForgotPassword" method="post">
        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
        <div class="mb-3">
            <label asp-for="Email" class="form-label"></label>
            <input asp-for="Email" class="form-control" autocomplete="email" />
            <span asp-validation-for="Email" class="text-danger"></span>
        </div>
        <button class="btn btn-primary w-100" type="submit">Gửi mã xác nhận</button>
    </form>
    <p class="mt-3 mb-0"><a asp-action="NkkLogin">Quay lại đăng nhập</a></p>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

