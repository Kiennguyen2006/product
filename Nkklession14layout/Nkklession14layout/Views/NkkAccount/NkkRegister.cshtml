@model Nkklession14layout.Models.NkkRegisterViewModel
@{
    ViewData["Title"] = "Tạo tài khoản";
}

<div class="auth-card">
    <h1 class="h3 mb-3">Tạo tài khoản</h1>
    <p class="text-muted">Tài khoản mới được cấp quyền nhân viên tiêu chuẩn.</p>
    <form asp-action="NkkRegister" method="post">
        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
        <div class="mb-3">
            <label asp-for="UserName" class="form-label"></label>
            <input asp-for="UserName" class="form-control" autocomplete="username" />
            <span asp-validation-for="UserName" class="text-danger"></span>
        </div>
        <div class="mb-3">
            <label asp-for="Email" class="form-label"></label>
            <input asp-for="Email" class="form-control" autocomplete="email" />
            <span asp-validation-for="Email" class="text-danger"></span>
        </div>
        <div class="mb-3">
            <label asp-for="Password" class="form-label"></label>
            <input asp-for="Password" class="form-control" autocomplete="new-password" />
            <span asp-validation-for="Password" class="text-danger"></span>
        </div>
        <div class="mb-3">
            <label asp-for="ConfirmPassword" class="form-label"></label>
            <input asp-for="ConfirmPassword" class="form-control" autocomplete="new-password" />
            <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
        </div>
        <button class="btn btn-primary w-100" type="submit">Tạo tài khoản</button>
    </form>
    <p class="mt-3 mb-0"><a asp-action="NkkLogin">Quay lại đăng nhập</a></p>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

