@model NetCoreLAB6_EF.Models.NkkProduct

@{
    ViewData["Title"] = "Chỉnh sửa sản phẩm";
}

<div class="container mt-4" style="max-width: 600px;">
    <h2>Chỉnh sửa sản phẩm</h2>
    <hr />

    <form asp-controller="NkkProduct" asp-action="Edit" enctype="multipart/form-data" method="post">
        <input type="hidden" asp-for="Id" />
        <input type="hidden" asp-for="Image" />
        <input type="hidden" asp-for="CreatedDate" />

        <div class="mb-3">
            <label class="form-label font-weight-bold">Tên sản phẩm</label>
            <input asp-for="Name" class="form-control" />
            <span asp-validation-for="Name" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label class="form-label font-weight-bold">Hình ảnh hiện tại</label>
            <div class="mb-2">
                @if (!string.IsNullOrEmpty(Model.Image))
                {
                    <img src="~/images/@Model.Image" width="100" class="img-thumbnail" />
                }
                else
                {
                    <span class="text-muted">Không có ảnh</span>
                }
            </div>
            <label class="form-label font-weight-bold">Đổi ảnh mới (nếu có)</label>
            <input type="file" name="imageFile" class="form-control" accept="image/*" />
        </div>

        <div class="row">
            <div class="col-md-6 mb-3">
                <label class="form-label font-weight-bold">Giá bán</label>
                <input asp-for="Price" type="number" step="0.01" class="form-control" />
                <span asp-validation-for="Price" class="text-danger"></span>
            </div>
            <div class="col-md-6 mb-3">
                <label class="form-label font-weight-bold">Giá khuyến mãi</label>
                <input asp-for="SalePrice" type="number" step="0.01" class="form-control" />
                <span asp-validation-for="SalePrice" class="text-danger"></span>
            </div>
        </div>

        <div class="mb-3">
            <label class="form-label font-weight-bold">Trạng thái</label>
            <select asp-for="Status" class="form-select">
                <option value="1">Hiển thị</option>
                <option value="0">Ẩn</option>
            </select>
        </div>

        <div class="mb-3">
            <label class="form-label font-weight-bold">Danh mục</label>
            <select asp-for="CategoryId" class="form-select" asp-items="ViewBag.CategoryId"></select>
            <span asp-validation-for="CategoryId" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label class="form-label font-weight-bold">Mô tả</label>
            <textarea asp-for="Descriptions" class="form-control" rows="3"></textarea>
            <span asp-validation-for="Descriptions" class="text-danger"></span>
        </div>

        <div class="d-flex gap-2">
            <button type="submit" class="btn btn-primary">Cập nhật</button>
            <a asp-controller="NkkProduct" asp-action="NkkProduct" class="btn btn-secondary">Quay lại danh sách</a>
        </div>
    </form>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}